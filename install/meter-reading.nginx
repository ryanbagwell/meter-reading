server {
    listen 80;
    server_name _;

    # Serve Django static files directly without hitting Gunicorn.
    location /api-static/ {
        alias /opt/meter-reading/src/api/staticfiles/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Route /api/ requests directly to the Django/gunicorn backend.
    location /api/ {
        proxy_pass         http://127.0.0.1:9005;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Route everything else to the Next.js UI server.
    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        'upgrade';
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
