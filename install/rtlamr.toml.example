# rtlamr.toml — RTL-SDR meter reader configuration
# Installed to /etc/meter-reading/rtlamr.toml by the setup script.
# CLI flags always take precedence over values in this file.

api_url = http://localhost/api/meter/readings/
# api_key = ""              # set if METER_API_REQUIRE_AUTH = true in meter-reading.env

meter_id = 1554226342       # uncomment to filter readings to one specific meter

# Protocol to decode. Options: scmplus, scm, idm, netidm, r900
# Leave commented to decode all Manchester protocols (scmplus, scm, idm, netidm).
protocol = "scmplus"

# Hardware tuning — safe to leave at defaults
# gain        = "auto"      # tuner gain in dB, or "auto"
# chip_length = 72          # chip length in samples (~2.36 MHz sample rate)
# verbose     = false
# duration    = 0           # stop after N seconds; 0 = run forever
