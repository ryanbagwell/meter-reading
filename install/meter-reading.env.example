# ── API server ───────────────────────────────────────────────────────────────
# Port the API listens on. The UI proxy hardcodes localhost:9005 — if you
# change this, also update ui/app/api/proxy/[...path]/route.ts.
API_PORT=9005

# Set to "true" to require an X-API-Key header on all API requests.
METER_API_REQUIRE_AUTH=false

# Value of the X-API-Key header (only used when METER_API_REQUIRE_AUTH=true).
METER_API_KEY=

# Django secret key — change this before exposing the API outside localhost.
DJANGO_SECRET_KEY=change-me-in-production

# Django module path (do not change)
DJANGO_SETTINGS_MODULE=entry.settings
